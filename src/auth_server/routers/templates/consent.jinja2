{% extends "base.jinja2" %}
{% block title %}Approve access{% endblock %}
{% block content %}
    <h1>Approve access</h1>
    <p class="lead">An application is requesting access to your identity.</p>

    <section class="section">
        <h2>Requested access</h2>
        {% if requested_access %}
        <ul>
            {% for access in requested_access %}
            <li>{{ access }}</li>
            {% endfor %}
        </ul>
        {% else %}
        <p class="empty">No specific access was requested.</p>
        {% endif %}
    </section>

    <section class="section">
        <h2>Requested information about you</h2>
        {% if requested_subject %}
        <ul>
            {% for subject in requested_subject %}
            <li>{{ subject }}</li>
            {% endfor %}
        </ul>
        {% else %}
        <p class="empty">No information about you was requested.</p>
        {% endif %}
    </section>

    <p class="notice">
        The authorization server cannot verify which application made this request.
        Only continue if you started this yourself.
    </p>

    <form class="actions" action="{{ consent_url }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <button type="submit" name="decision" value="deny" class="button">Deny</button>
        <button type="submit" name="decision" value="approve" class="button button-primary">Approve</button>
    </form>
{% endblock %}
