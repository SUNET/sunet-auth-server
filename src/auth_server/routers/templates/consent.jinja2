<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Approve access</title>
    <link href="{{ url_for('static', path='/styles.css') }}" rel="stylesheet">
</head>
<body>
    <div class="section">
        <h3>Approve access</h3>
    </div>
    <div class="section">
        <p>An application is requesting access to your identity.</p>
    </div>
    <div class="section">
        <h4>Requested access</h4>
        {% if requested_access %}
        <ul>
            {% for access in requested_access %}
            <li>{{ access }}</li>
            {% endfor %}
        </ul>
        {% else %}
        <p>No specific access was requested.</p>
        {% endif %}
    </div>
    <div class="section">
        <h4>Requested information about you</h4>
        {% if requested_subject %}
        <ul>
            {% for subject in requested_subject %}
            <li>{{ subject }}</li>
            {% endfor %}
        </ul>
        {% else %}
        <p>No information about you was requested.</p>
        {% endif %}
    </div>
    <div class="section">
        <p>
            The authorization server cannot verify which application made this request.
            Only continue if you started this yourself.
        </p>
    </div>
    <div class="form">
        <form action="{{ consent_url }}" method="post">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <button type="submit" name="decision" value="deny">Deny</button>
            <button type="submit" name="decision" value="approve">Approve</button>
        </form>
    </div>
</body>
</html>
